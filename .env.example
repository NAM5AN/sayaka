# sayaka-chat 서버 환경변수 예시. 실제 값은 .env.local(로컬) 또는 Vercel 프로젝트 설정에만 넣고 커밋하지 마세요.
# NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요 (브라우저로 노출됨).

# ── OpenAI (필수: 실제 응답 생성) ──
OPENAI_API_KEY=
# OpenAI 모델 페이지에서 Structured Outputs(json_schema strict)를 지원하는 현재 모델 ID 를 확인해 입력
OPENAI_MODEL=
# (선택) 추론 모델일 때만: none | minimal | low | medium | high | xhigh | max  — 모델이 지원하는 값만
OPENAI_REASONING_EFFORT=
# (선택) temperature 를 지원하는 모델일 때만. 비워 두면 보내지 않음
OPENAI_TEMPERATURE=
# (선택) 기본 2500. 추론 모델은 추론 토큰도 여기에 포함됨
OPENAI_MAX_OUTPUT_TOKENS=
# (선택) 호출 1회당 제한. 기본 45000 (ms). 재생성까지 한 턴 최대 약 2배
OPENAI_TIMEOUT_MS=
# (선택) off 로 두면 OpenAI Moderation(무료) 입력·출력 점검을 끔. 기본 on
OPENAI_MODERATION=

# ── 데이터베이스 ──
# 비워 두면 로컬 내장 DB(.data/pglite) 사용. Vercel 배포 시에는 필수 (사야카 전용 새 Postgres/Supabase 프로젝트)
DATABASE_URL=
# (선택) verify | no-verify | disable. 기본: localhost 는 disable, 그 외 no-verify(암호화하되 인증서 검증 생략)
DATABASE_SSL=

# ── 접속 보호 ──
# 운영(배포)에서는 APP_PASSWORD 와 SESSION_SECRET 이 없으면 사이트가 열리지 않음. 로컬 `npm run dev` 에서 비우면 비밀번호 없이 열림
APP_PASSWORD=
# (선택) 이 비밀번호로 로그인하면 응답 진단·대화방 상태를 볼 수 있음
ADMIN_PASSWORD=
# 32자 이상 임의 문자열 (예: openssl rand -base64 48)
SESSION_SECRET=

# ── 사용량 제한 (선택) ──
RATE_LIMIT_PER_MINUTE=12
DAILY_GENERATION_LIMIT=300
MAX_INPUT_CHARS=2000
# 원문 그대로 보내는 최근 메시지 수 (그 이전은 대화방 기억으로 요약 전달)
HISTORY_WINDOW=24

# ── 개발용 ──
# stub 이면 OpenAI 를 부르지 않고 '테스트 스텁(실제 AI 아님)' 응답을 표시
AI_MODE=
